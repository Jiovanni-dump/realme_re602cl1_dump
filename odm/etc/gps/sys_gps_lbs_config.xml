<?xml version="1.0" encoding="UTF-8"?>
<filter-conf>
    <Android-Version>16</Android-Version>
    <version>20250424</version>

    <!-- config for oplus-pdr -->
    <bool ID="2032">true</bool>
    <!-- config for oplus global flp -->
    <integer ID="3087">1</integer>

    <!-- config for gnss sv strategy -->
    <bool ID="2064">true</bool>
    <string ID="5038">Q,300,4000</string>

    <!-- config for 3dma feature -->
    <integer ID="3073">1</integer>

    <!-- config for disabling qcom xtra throttle -->
    <bool ID="2078">true</bool>

    <!-- config for allow reset gms-->
    <bool ID="2088">true</bool>

    <!-- config for gnss power -->
    <bool ID="2075">true</bool>

    <!-- config for metal case detection -->
    <!-- bit 0: enable metal case detection feature -->
    <!-- bit 1: enable sensor detection -->
    <!-- bit 2: enable gnss status detection -->
    <!-- bit 3: enable debug report detection -->
    <!-- bit 4: enable gnss fix detection -->
    <integer ID="3046">30</integer>

    <!-- config for geofence -->
    <!-- bit 0: enable low power geofence -->
    <!-- bit 1: enable low power wifi fence -->
    <!-- bit 2: enable low power cell fence -->
    <!-- bit 3: enable always location -->
    <integer ID="3083">15</integer>
</filter-conf>
