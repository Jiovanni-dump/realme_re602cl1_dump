    </special>
    <special package="com.android.systemui">
        <!--201-WMS动画开始-->
        <item type="20111" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="true" isInGameAnim="true" /> <!--折叠屏转场:大小屏切换动画-->
        <item type="20102" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--dialog弹窗弹出收起/PIP出现消失&拖动-->
        <item type="20104" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="true" isInGameAnim="true" /> <!--单手模式进入退出、屏幕旋转-->
        <item type="20105" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--闪达浮窗（非即时结束交互 & 弱平移动画）-->
        <item type="20106" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--闪达浮窗（非即时结束交互 & 强平移动画）-->
        <item type="20107" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--闪达浮窗（即时结束交互）-->
        <item type="20108" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--分屏与PS（非即时结束交互 & 弱平移动画）-->
        <item type="20109" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--分屏与PS（非即时结束交互 & 强平移动画）-->
        <item type="20110" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--分屏与PS（即时结束交互）-->
        <!--201-WMS动画结束-->
        <!--203-通知中心动画开始-->
        <item type="20301" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--横幅通知、简洁横幅弹出收起（横幅弹出、横幅自动收起、简洁横幅弹出、简洁横幅自动收起）-->
        <item type="20302" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--横幅、简洁横幅点击启动应用-->
        <item type="20303" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--横幅下拉出浮窗-->
        <item type="20304" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--横幅滑动操作及结束后动画：长按横幅出现通知设置、横幅的上划收起、横幅/简洁横幅侧滑删除-->
        <!--203-通知中心动画结束-->
        <!--204-流体云动画开始-->
        <item type="20401" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="true" isInGameAnim="true" /> <!--应用级别大幅变化:开启应用、应用-胶囊-->
        <item type="20402" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--卡组变化、大卡片级别变化、小卡片级别变化-->
        <item type="20403" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--流程云卡片长按出现菜单-->
        <!--204-流体云动画结束-->
        <!--205-音量条动画开始-->
        <item type="20501" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--音量条出现/消失-->
        <item type="20502" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--音量条展开成多个、展开的音量条的消失、应用音量单独调节界面的进入和消失-->
        <!--205-音量条动画结束-->
        <!--10-应用内可突破60hz动画开始-->
        <item type="10001" enable="true" targetFramerate="120" enableEndLowRate="false" velocityFramerate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!-- OverScroller/OplusSpringOverScroller在屏滑动（列表滑动、短视频场景滑动） -->
        <item type="10003" enable="true" targetFramerate="120" enableEndLowRate="true" velocityFramerate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!-- OverScroller/OplusSpringOverScroller fling（离屏fling，一般用于列表滑动场景 -->
        <item type="10102" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--COUI列表滑动动画（COUIRecyclerView）--> 
        <item type="10103" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--COUI Page页面切换动画（COUIviewpager）-->    
        <!--10-应用内可突破60hz动画结束-->
    </special>
    <special package="com.android.launcher">
        <item type="20202" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="true" isWidespreadAnim="true" isInGameAnim="true" isLauncherAnim="true" /> <!--解锁进桌面动画-->
