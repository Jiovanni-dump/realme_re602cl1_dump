    <special package="com.coloros.floatassistant">
        <item type="50101" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--悬浮球拖动-->
        <item type="50102" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--悬浮球点击展开/收起-->
    </special>
    <special package="com.coloros.smartsidebar">
        <item type="50201" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--拉出/收起侧边栏动画、展开全部面板、taskbar最近文件面板出现/消失-->
        <item type="50202" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!--智能提醒-->
        <!--10-应用内可突破60hz动画开始-->
        <item type="10001" enable="true" targetFramerate="120" enableEndLowRate="false" velocityFramerate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!-- OverScroller/OplusSpringOverScroller在屏滑动（列表滑动、短视频场景滑动） -->
        <item type="10003" enable="true" targetFramerate="120" enableEndLowRate="true" velocityFramerate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!-- OverScroller/OplusSpringOverScroller fling（离屏fling，一般用于列表滑动场景 -->
        <item type="10102" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--COUI列表滑动动画（COUIRecyclerView）--> 
        <item type="10103" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--COUI Page页面切换动画（COUIviewpager）-->    
        <!--10-应用内可突破60hz动画结束-->
    </special>
    <special package="com.oplus.screenshot">
        <item type="50301" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="true" isInGameAnim="true" /> <!--截图浮窗动画-->
    </special>
    <special package="com.oplus.games">
        <!--10-应用内可突破60hz动画开始-->
        <item type="10001" enable="true" targetFramerate="120" enableEndLowRate="false" velocityFramerate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!-- OverScroller/OplusSpringOverScroller在屏滑动（列表滑动、短视频场景滑动） -->
        <item type="10003" enable="true" targetFramerate="120" enableEndLowRate="true" velocityFramerate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" /> <!-- OverScroller/OplusSpringOverScroller fling（离屏fling，一般用于列表滑动场景 -->
        <item type="10102" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--COUI列表滑动动画（COUIRecyclerView）--> 
        <item type="10103" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--COUI Page页面切换动画（COUIviewpager）-->    
        <!--10-应用内可突破60hz动画结束-->
