        <item type="20109" enable="true" targetFramerate="120" enableEndLowRate="false" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--分屏与PS（非即时结束交互 & 强平移动画）-->
        <item type="20110" enable="true" targetFramerate="120" enableEndLowRate="true" enableBreakAppRate60="true" enableBreakAppRate90="false" isWidespreadAnim="false" isInGameAnim="true" /> <!--分屏与PS（即时结束交互）-->
